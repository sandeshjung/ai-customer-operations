# Application
APP_NAME=AI Customer Operations
APP_ENV=development
# DEBUG=true also allows CORS from any localhost/127.0.0.1 port (see main.py).
# Defaults to false if unset. Set DEBUG=false and CORS_ALLOWED_ORIGINS below
# before any real deployment.
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# Auth — required. Shared secret sent as the X-API-Key header; gates every
# mutating endpoint and the whole /admin/* router. Pick any string. If unset,
# protected endpoints fail closed with a 503 rather than silently opening up.
ADMIN_API_KEY=REPLACE_ME

# Admin console simulator (/admin/demo/*): creates real customers, orders and
# tickets, and every simulated order costs LLM calls. Set false to turn the
# endpoints off (they return 404).
DEMO_ENDPOINTS_ENABLED=true

# Fixed-window rate limiting via Redis on sensitive endpoints (delay
# detection, portal order lookup). Set to false only for local load tests.
RATE_LIMIT_ENABLED=true

# CORS — only used when DEBUG=false. Comma-separated, e.g.
# https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# PostgreSQL
# The password must match docker-compose.yml's postgres service
# (customer_admin) for host-side commands like `make seed` and
# `alembic upgrade head` to connect. The api/worker containers override
# POSTGRES_HOST and POSTGRES_PASSWORD themselves.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_operations
POSTGRES_USER=customer_admin
POSTGRES_PASSWORD=customer_admin

# Redis
# The client connects via redis_url (lowercase — the setting name is
# case-sensitive). REDIS_HOST/REDIS_PORT exist in config.py but nothing
# currently reads them. The api/worker containers override redis_url.
redis_url=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant + embeddings
# The worker ingests data/knowledge/ into QDRANT_COLLECTION on first start
# if the collection doesn't exist. Changing EMBEDDING_MODEL means re-ingesting
# (drop the collection) — vectors from different models aren't comparable.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=customer_operations_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector results below this cosine similarity are dropped (see config.py for
# how 0.45 was chosen; re-measure if you change EMBEDDING_MODEL).
RAG_MIN_SIMILARITY=0.45

# LLM
# Replace the API key with a placeholder before committing.
# Any Groq chat model with tool calling works; check what your key can use
# with: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_KEY=REPLACE_ME
LLM_MODEL=openai/gpt-oss-120b

# Notifications
# Default ("log") only logs and records a Notification row — see
# notification_service.py. To also deliver real email via Mailjet for a demo,
# set MAILJET_DEMO_ENABLED=true and fill in the values below (get a key at
# https://app.mailjet.com/account/api_keys; the sender must be verified).
# Every customer email goes out then — including to seeded customers.
NOTIFICATION_BACKEND=log
MAILJET_DEMO_ENABLED=false
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_SENDER_EMAIL=
# MAILJET_SENDER_NAME=Customer Support
# Where "View status" links in customer emails point (the customer portal).
CUSTOMER_PORTAL_URL=http://localhost:8081

# Observability
# Default points at the local Jaeger container (docker compose up -d jaeger).
# UI: http://localhost:16686 — no signup needed. To export to Langfuse
# instead, point the endpoint at Langfuse's OTLP URL and set the headers
# (e.g. Authorization=Basic <base64 public:secret>) — no code changes.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-customer-operations
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# Not currently read by the backend — the admin console's trace links use
# its own Jaeger URL (localStorage "adminJaegerUrl", default localhost:16686).
JAEGER_UI_URL=http://localhost:16686

# Worker health check — see app/workers/health.py. Docker's healthcheck
# (and the autoheal container) polls http://localhost:WORKER_HEALTH_PORT/health;
# it reports unhealthy if the consumer loop hasn't heartbeated within the TTL.
WORKER_HEALTH_PORT=8001
WORKER_HEARTBEAT_TTL_SECONDS=60
