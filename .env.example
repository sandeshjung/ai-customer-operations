# Application
APP_NAME=AI Customer Operations
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_operations
POSTGRES_USER=customer_admin
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM
# Replace the API key with a placeholder before committing.
LLM_API_KEY=REPLACE_ME
LLM_MODEL=openai/gpt-oss-120b


# Notifications
# Default ("log") only logs and records a Notification row — see
# notification_service.py. To actually deliver via Mailjet for a demo,
# uncomment the single call to _demo_send_via_mailjet() in that file and
# fill in the values below (get a key at https://app.mailjet.com/account/api_keys).
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_SENDER_EMAIL=
# MAILJET_SENDER_NAME=Customer Support

# Observability
# Default points at the local Jaeger container (docker compose up -d jaeger).
# UI: http://localhost:16686 — no signup needed.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-customer-operations
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_UI_URL=http://localhost:16686