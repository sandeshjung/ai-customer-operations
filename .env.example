# Application
APP_NAME=AI Customer Operations
APP_ENV=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_operations
